FROM golang:1.15 as builder
ARG GOPROXY=direct
WORKDIR /go/src/napoli
COPY . .
RUN go get -d -v ./... 
RUN CGO_ENABLED=0 go build -ldflags="-w -s -extldflags -static" -o napoli ./cmd/nps/nps.go

FROM scratch
COPY --from=builder /go/src/napoli/napoli /
COPY --from=builder /go/src/napoli/web /web
VOLUME /conf
CMD ["/napoli"]
